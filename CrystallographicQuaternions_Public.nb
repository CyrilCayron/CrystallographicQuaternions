 RowBox[{"myq2", " ", "=", " ", 
  RowBox[{"AngAxistoQ", "[", 
   RowBox[{"\[Alpha]2", " ", ",", "v2", ",", "MetTens"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<their norms are:\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"NormQ", "[", 
  RowBox[{"myq1", ",", "MetTens"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"NormQ", "[", 
  RowBox[{"myq2", ",", "MetTens"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", 
  "[", "\"\<Their (crystallographic quaternion) product is q \>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"myq12", " ", "=", " ", 
  RowBox[{"prodQ", "[", 
   RowBox[{"myq1", ",", "myq2", ",", "MetTens"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<The norm of the quaternion product is\>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"NormQ", "[", 
  RowBox[{"myq12", ",", "MetTens"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<The quaternion written as ang,axis is \>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
