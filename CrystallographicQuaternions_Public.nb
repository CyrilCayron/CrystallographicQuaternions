    RowBox[{"myq12", ",", "MetTens"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Rot angle = \>\"", ",", "ang12", 
    ",", "\"\<, Rot axis in cryst = \>\"", ",", "axis12"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", 
  "[", "\"\<Checking this result by using the structure tensor (ie by using \
an intermediate Cartesian basis)\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"q1", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
