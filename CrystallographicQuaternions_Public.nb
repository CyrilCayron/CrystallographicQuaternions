       RowBox[{"\[Alpha]2", "/", "2"}], "]"}], 
      RowBox[{"Normalize", "[", 
       RowBox[{"StructTens", ".", "v2"}], "]"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
