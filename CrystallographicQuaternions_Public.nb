     RowBox[{
      RowBox[{"Sin", "[", 
       RowBox[{"\[Alpha]1", "/", "2"}], "]"}], " ", 
      RowBox[{"Normalize", "[", 
       RowBox[{"StructTens", ".", "v1"}], "]"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"q2", " ", "=", " ", 
