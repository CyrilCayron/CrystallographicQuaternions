 RowBox[{"Print", 
  "[", "\"\<After convertion of ang,axis, the two crystallographic \
quaternions are q1 q2 given by :\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"myq1", " ", "=", " ", 
  RowBox[{"AngAxistoQ", "[", 
